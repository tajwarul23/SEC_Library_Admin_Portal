# Copy to .env. On Vercel, set it in Project → Settings → Environment Variables.
#
# Backend API base URL, INCLUDING /api (this app's services call "/admin/...").
#   Local:      http://localhost:5000/api
#   Production: https://<your-render-app>.onrender.com/api
# Note: the student app's VITE_API_URL is the same URL WITHOUT /api.
VITE_API_URL=http://localhost:5000/api
